pipeline {
  agent {
    kubernetes {
      cloud 'kubernetes'
      defaultContainer 'jnlp'
      yaml """
apiVersion: v1
kind: Pod
spec:
  serviceAccountName: jenkins-pipeline
  automountServiceAccountToken: false
  nodeSelector:
    workload: jenkins
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
  containers:
    - name: jnlp
      image: local/jenkins-agent:kind
      imagePullPolicy: IfNotPresent
      resources:
        requests: {cpu: 200m, memory: 256Mi}
        limits: {cpu: '1', memory: 768Mi}
      volumeMounts:
        - {name: pipeline, mountPath: /run/pipeline}
        - {name: vault-token, mountPath: /var/run/vault, readOnly: true}
        - {name: vault-ca, mountPath: /etc/vault-ca, readOnly: true}
    - name: buildkit
      image: moby/buildkit:rootless@sha256:65eca3c01cd1180c8f64565c4e3c5983af5145818b0e6fa863385d099eb73855
      command: [sh, -c, 'sleep infinity']
      env:
        - {name: BUILDKITD_FLAGS, value: '--oci-worker-no-process-sandbox'}
        - {name: DOCKER_CONFIG, value: /run/pipeline/docker}
      securityContext:
        seccompProfile: {type: Unconfined}
        appArmorProfile: {type: Unconfined}
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {cpu: '1', memory: 1Gi}
      volumeMounts:
        - {name: pipeline, mountPath: /run/pipeline}
  volumes:
    - name: pipeline
      emptyDir: {medium: Memory, sizeLimit: 256Mi}
    - name: vault-token
      projected:
        defaultMode: 0440
        sources:
          - serviceAccountToken: {audience: vault, expirationSeconds: 600, path: token}
    - name: vault-ca
      configMap: {name: vault-ca}
"""
    }
  }
  parameters {
    booleanParam(name: 'FAIL_ROLLOUT', defaultValue: false, description: 'LOCAL ONLY: induce failure after a healthy revision to verify rollback')
  }
  options {
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
    skipDefaultCheckout(true)
  }
  environment {
    REGISTRY_IMAGE = "${env.LOCAL_REGISTRY}/devops-java-service"
  }
  stages {
    stage('Checkout') {
      steps {
        script {
          def source = checkout scm
          env.GIT_COMMIT = source.GIT_COMMIT
          env.IMAGE = "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT}-${env.BUILD_NUMBER}"
        }
      }
    }
    stage('Vault before build') {
      steps { sh 'sh scripts/read-vault.sh' }
    }
    stage('Build and test Java 21') {
      steps {
        sh '''set +x
export DEMO_MESSAGE="$(cat /run/pipeline/DEMO_MESSAGE)"
sh scripts/test.sh
'''
        container('buildkit') {
          sh 'set +x; export DEMO_MESSAGE="$(cat /run/pipeline/DEMO_MESSAGE)"; buildctl-daemonless.sh build --frontend dockerfile.v0 --local context=. --local dockerfile=. --output type=image,name=$IMAGE,push=false,registry.insecure=true'
        }
      }
    }
    stage('Push immutable image') {
      steps {
        container('buildkit') {
          sh 'set +x; export DEMO_MESSAGE="$(cat /run/pipeline/DEMO_MESSAGE)"; buildctl-daemonless.sh build --frontend dockerfile.v0 --local context=. --local dockerfile=. --output type=image,name=$IMAGE,push=true,registry.insecure=true --metadata-file /run/pipeline/image-metadata.json'
        }
        script {
          env.IMAGE = sh(script: "jq -er '.\"containerimage.digest\"' /run/pipeline/image-metadata.json", returnStdout: true).trim()
          env.IMAGE = "${env.REGISTRY_IMAGE}@${env.IMAGE}"
        }
      }
    }
    stage('Deploy development') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig-development', variable: 'KUBECONFIG')]) {
          script {
            sh 'cp local-demo/deployment.yaml k8s/deployment.yaml'
            if (params.FAIL_ROLLOUT) { env.IMAGE = "${env.REGISTRY_IMAGE}:deliberately-missing-${env.BUILD_NUMBER}" }
            sh 'sh scripts/deploy.sh'
          }
        }
      }
    }
  }
  post {
    failure {
      script {
        if (fileExists('/run/pipeline/deploy-started')) {
          withCredentials([file(credentialsId: 'kubeconfig-development', variable: 'KUBECONFIG')]) {
            sh 'sh scripts/rollback.sh'
          }
        }
      }
    }
    cleanup {
      sh 'set +x; find /run/pipeline -type f -exec truncate -s 0 {} +'
      deleteDir()
    }
  }
}
